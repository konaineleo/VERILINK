



{
  "manifest_version": 3,
  "name": "VERIKLIK",
  "version": "0.2.0",
  "description": "Check before you click: scan suspicious links with VERIKLIK.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Scan with VERIKLIK"
  }
}